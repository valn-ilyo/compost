{
  "name": "compost",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"if (require('fs').existsSync('dist')) require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "generate-pwa": "pwa-assets-generator",
    "dev": "vite",
    "build-only": "vite build",
    "postbuild": "node -e \"require('fs').writeFileSync('dist/.nojekyll', '')\"",
    "type-check": "vue-tsc --build",
    "build": "run-s clean generate-pwa type-check build-only",
    "preview": "vite preview",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "deploy": "gh-pages -d dist --dotfiles",
    "ship-it": "run-s build deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "@vueuse/motion": "^3.0.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "vuetify": "^4.0.6",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.6.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.62.0",
    "eslint-plugin-vue": "~10.9.0",
    "gh-pages": "^6.3.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.47.0",
    "oxlint": "~1.62.0",
    "sass": "^1.99.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.2.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
