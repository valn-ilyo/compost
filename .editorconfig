root = true

[*]
charset = utf-8
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
max_line_length = 100

# Vue components — PascalCase enforced at IDE level
[*.vue]
indent_size = 2

# TypeScript — kebab-case files enforced via ESLint, not editorconfig
[*.ts]
indent_size = 2

# Assets — lowercase only
[*.{png,jpg,svg,gif,webp}]
# filename_convention = kebab-case (documented; enforced by code review)
